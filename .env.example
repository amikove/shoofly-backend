PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=change_this_to_a_very_long_random_string_in_production
JWT_EXPIRES_IN=7d

# PostgreSQL (Render/Railway fournit DATABASE_URL automatiquement)
DATABASE_URL=postgresql://user:password@localhost:5432/shoofly

# CORS — URL de ton front
FRONTEND_URL=http://localhost:5173

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Resend (envoi d'emails transactionnels — mot de passe oublié). Sans cette clé, l'envoi est
# ignoré proprement (skipped) au lieu d'échouer — voir services/email.js.
RESEND_API_KEY=

# Sentry (suivi d'erreurs backend) — voir src/instrument.js. Sans cette clé, Sentry est
# désactivé silencieusement (l'app démarre et fonctionne normalement).
SENTRY_DSN=

# Web Push / VAPID (canal push - services/push.js). Sans ces cles, le canal push est
# desactive silencieusement (l'app demarre et fonctionne normalement).
# Generer une paire : node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@shoofly.ma

# Paiement en ligne PayZone (config/onlinePayment.js) : 'true' pour l'activer. Absente = desactive
# (init / retry / failed-attempts -> 403 ONLINE_PAYMENT_DISABLED ; le callback reste ouvert).
# A basculer EN MEME TEMPS que payzone.enabled dans shoofly-react/src/constants/paymentMethods.js.
ONLINE_PAYMENT_ENABLED=false

# Recharge du wallet Oeil par CashPlus (services/cashplus.js, config/cashplus.js).
# CASHPLUS_ENABLED : 'true' pour l'activer. Absente = desactivee : generate-token -> 403
#   CASHPLUS_DISABLED et bouton "Recharger" masque (GET /users/oeil/earnings -> cashplus_enabled).
#   Le callback CashPlus reste ouvert (un paiement deja lance en agence doit crediter).
# CASHPLUS_API_BASE_URL : URL de base de l'API CashPlus (appel generate-token).
# CASHPLUS_MARCHAND_CODE : code marchand Shoofly fourni par CashPlus (signe generate-token).
# CASHPLUS_SECRET_KEY : cle secrete CashPlus (signature de generate-token et verification du
#   HMAC du callback). Secret : jamais dans le depot.
# FIXIE_URL : proxy a IP fixe (Fixie) par lequel sortent les appels vers CashPlus (IP autorisee
#   chez CashPlus). Absente = appel direct.
CASHPLUS_ENABLED=false
CASHPLUS_API_BASE_URL=
CASHPLUS_MARCHAND_CODE=
CASHPLUS_SECRET_KEY=
FIXIE_URL=
